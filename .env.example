# ERFlow Frontend Environment Configuration
# Add this environment variable in Render -> Static Site -> Environment

# Target FastAPI Backend Service URL (e.g. https://erflow-backend.onrender.com)
VITE_API_BASE_URL=https://erflow-backend.onrender.com

# Optional Chatbot Microservice API URL (defaults to VITE_API_BASE_URL if omitted)
VITE_CHATBOT_API_URL=https://erflow-backend.onrender.com

# Default Application Mode ("REAL" or "DEMO")
VITE_ERFLOW_APP_MODE=REAL
