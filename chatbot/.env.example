# ==============================================================================
# AI-Based Emergency Room Patient Flow Prediction - Chatbot Environment Config
# ==============================================================================

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
MAX_HISTORY_PER_SESSION=50

# ML Model Directory & Version
MODEL_DIR=./models
MODEL_VERSION=1.0.0

# Future Trained Model Artifact Paths (Relative Paths)
# Note: The chatbot will start and run cleanly even if these files do not exist yet.
PATIENT_VOLUME_MODEL_PATH=./models/patient_volume_model.pkl
WAITING_TIME_MODEL_PATH=./models/waiting_time_model.pkl
CROWDING_MODEL_PATH=./models/crowding_model.pkl
HIGH_DEMAND_MODEL_PATH=./models/high_demand_model.pkl

# Developer Mode (Set to True only if running mock predictions offline)
USE_MOCK_MODELS=False
